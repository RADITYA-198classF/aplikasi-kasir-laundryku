APP_NAME=LaundryKu
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=single
LOG_LEVEL=debug

# --- Database -----------------------------------------------------------
# Default: SQLite (file database/database.sqlite, tanpa instal apa pun).
DB_CONNECTION=sqlite

# Untuk MySQL / MariaDB (XAMPP, Laragon): hapus tanda # di bawah dan komentari DB_CONNECTION=sqlite di atas.
# Buat dulu database kosong bernama "laundryku".
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laundryku
# DB_USERNAME=root
# DB_PASSWORD=

# Penting: jangan pakai driver "database" (butuh tabel tambahan yang tidak dibuat di sini).
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
