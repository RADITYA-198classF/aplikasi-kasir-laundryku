APP_NAME=LaundryKu
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=single
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------
# Default: MySQL / MariaDB (XAMPP, Laragon). Buat dulu database kosong "laundryku".
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laundryku
DB_USERNAME=root
DB_PASSWORD=

# Alternatif SQLite (tanpa install server): ganti DB_CONNECTION=sqlite, hapus
# baris DB_HOST/PORT/DATABASE/USERNAME/PASSWORD di atas, lalu buat file
# database/database.sqlite (atau jawab "yes" saat php artisan migrate menawarkannya).

# Penting: jangan pakai driver "database" (butuh tabel tambahan yang tidak dibuat di sini).
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Produksi: set APP_ENV=production dan APP_DEBUG=false.